# MarketAI Community — exemplo de ambiente do Cloud
DATABASE_URL=sqlite:///./marketai-cloud.db

# Segurança - TROQUE em produção
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-64-caracteres
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ADMIN_API_KEY=troque-esta-chave-admin
TERMS_VERSION=2026-10

# URLs públicas
PUBLIC_API_URL=http://127.0.0.1:9000
PUBLIC_APP_URL=http://127.0.0.1:9000
UPDATE_MANIFEST_URL=

# Market data / IA — opcionais e mantidos somente no servidor
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_COPILOT_MODEL=
MERCADOLIVRE_ACCESS_TOKEN=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
SERPAPI_KEY=

# Painel administrativo
ADMIN_PANEL_ENABLED=true
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NAME=Administrador MarketAI

# Sentinel
SENTINEL_INTERVAL_MINUTES=60
SENTINEL_BATCH_SIZE=50

# Billing está DESABILITADO na edição Community.
# As variáveis de gateways abaixo existem apenas para compatibilidade com código legado.
# Não são necessárias para operar o MarketAI Community.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_URL=
MERCADOPAGO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
ALLOW_UNVERIFIED_WEBHOOKS=false
