# Banco (Railway Postgres em produção; SQLite funciona no desenvolvimento)
DATABASE_URL=sqlite:///./marketai-cloud.db

# Segurança - TROQUE em produção
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-64-caracteres
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Opcional: somente para automações/API administrativa legada. O painel /admin NÃO usa esta chave.
ADMIN_API_KEY=troque-esta-chave-admin
TERMS_VERSION=2026-10

# URLs públicas
PUBLIC_API_URL=http://127.0.0.1:9000
PUBLIC_APP_URL=https://marketai.example.com
UPDATE_MANIFEST_URL=https://marketai.example.com/releases/windows-stable.json

# Market data - ficam SOMENTE no servidor
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
MERCADOLIVRE_ACCESS_TOKEN=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
SERPAPI_KEY=

# Mercado Pago / Pix (Brasil)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_URL=https://api.seudominio.com/v1/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=

# Stripe - cartão de crédito/débito internacional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal - assinatura internacional
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# NUNCA habilite em produção. Útil somente para testes locais controlados.
ALLOW_UNVERIFIED_WEBHOOKS=false

# Planos padrão BRL/mês
PLAN_ESSENCIAL_PRICE=49.90
PLAN_PRO_PRICE=99.90
PLAN_BUSINESS_PRICE=199.90

# Preços internacionais opcionais. Se omitidos, o MarketAI usa os defaults do código.
PLAN_ESSENCIAL_PRICE_USD=9.99
PLAN_PRO_PRICE_USD=19.99
PLAN_BUSINESS_PRICE_USD=39.99
PLAN_ESSENCIAL_PRICE_EUR=9.49
PLAN_PRO_PRICE_EUR=18.99
PLAN_BUSINESS_PRICE_EUR=37.99
PLAN_ESSENCIAL_PRICE_GBP=7.99
PLAN_PRO_PRICE_GBP=15.99
PLAN_BUSINESS_PRICE_GBP=31.99

TRIAL_DAYS=7
TRIAL_ANALYSES=10

# PAINEL ADMINISTRATIVO
# Use uma senha longa e exclusiva em produção. Não reutilize a senha de e-mail/gateway.
ADMIN_PANEL_ENABLED=true
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NAME=Administrador MarketAI
# Por padrão, alterações feitas no painel Admin persistem após reiniciar o Cloud.
# Ative somente se quiser que os valores PLAN_* do ambiente sobrescrevam os planos a cada boot.
SYNC_PLAN_DEFAULTS_ON_STARTUP=false
