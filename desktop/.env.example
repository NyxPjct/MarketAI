# MarketAI Community — DEV / SELF-HOST
# No release oficial, as integrações sensíveis ficam no Cloud.
# Este arquivo existe para desenvolvimento e compatibilidade com versões anteriores.

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna

MERCADOLIVRE_ACCESS_TOKEN=

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

SERPAPI_KEY=

HTTP_TIMEOUT=12

# Contingência cambial: nunca é apresentada como cotação ao vivo.
FALLBACK_FX_USD_BRL=5.30
FALLBACK_FX_CNY_BRL=0.74
FALLBACK_FX_EUR_BRL=6.15

# MarketAI Cloud (em produção, aponte para seu domínio HTTPS)
MARKETAI_CLOUD_URL=http://127.0.0.1:9000

# Somente desenvolvimento. Não habilite em releases públicos.
MARKETAI_DEVELOPER_MODE=0
